@page "/settings"
@using AutoRip.Models
@using AutoRip.Services
@inject SettingsService SettingsService
@inject HandbrakeService HandbrakeService
@inject TransferService TransferService
@inject NavigationManager Navigation

<PageTitle>Settings — AutoRip</PageTitle>

<div class="settings-page">
    <h1 class="page-heading">Settings</h1>

    <div class="settings-content">
        <div class="card">
            <h2>TMDB Integration</h2>
            <p class="card-desc">Automatically identify movies using The Movie Database.</p>

            <div class="form-group">
                <label for="tmdbApiKey">API Key</label>
                <input id="tmdbApiKey" type="password" class="text-input" @bind="apiKey" placeholder="Paste your TMDB API key…" />
                <p class="hint">Get a free key at <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener">themoviedb.org/settings/api</a></p>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="autoDetect" />
                    <span>Auto-identify discs when inserted</span>
                </label>
            </div>
        </div>

        <div class="card">
            <h2>HandBrake Transcoding</h2>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="useCustom" />
                    <span>Use custom encoder settings</span>
                </label>
            </div>

            @if (!useCustom)
            {
                <div class="form-group">
                    <label for="hbPreset">Preset</label>
                    <div class="select-wrapper">
                        <select id="hbPreset" class="text-input" @bind="selectedPreset">
                            @if (presets.Count == 0)
                            {
                                <option value="">Loading…</option>
                            }
                            else
                            {
                                @foreach (var p in presets)
                                {
                                    <option value="@p">@p</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label for="hbEncoder">Encoder</label>
                    <div class="select-wrapper">
                        <select id="hbEncoder" class="text-input" @bind="selectedEncoder">
                            @foreach (var e in encoderOptions)
                            {
                                <option value="@e">@e</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="hbQuality">Quality (RF): @quality.ToString("F1")</label>
                    <input id="hbQuality" type="range" class="range-input" min="16" max="30" step="0.5" @bind="quality" @bind:event="oninput" />
                    <p class="hint">Lower = better quality, larger file. 16–30 for H.264.</p>
                </div>
                <div class="form-group">
                    <label for="hbSpeed">Encoder Speed</label>
                    <div class="select-wrapper">
                        <select id="hbSpeed" class="text-input" @bind="selectedSpeed">
                            <option value="ultrafast">Ultrafast (worst compression)</option>
                            <option value="superfast">Superfast</option>
                            <option value="veryfast">Veryfast</option>
                            <option value="faster">Faster</option>
                            <option value="fast">Fast</option>
                            <option value="medium">Medium (balanced)</option>
                            <option value="slow">Slow</option>
                            <option value="slower">Slower</option>
                            <option value="veryslow">Veryslow (best compression)</option>
                        </select>
                    </div>
                </div>
            }

            <hr class="card-divider" />
            <h3 class="card-subheading">Advanced</h3>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="webOptimized" />
                    <span>Web optimized (fast start)</span>
                </label>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="alignAv" />
                    <span>Align A/V start</span>
                </label>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="chapterMarkers" />
                    <span>Chapter markers</span>
                </label>
            </div>

            <div class="form-group">
                <label for="hbFramerate">Framerate</label>
                <div class="select-wrapper">
                    <select id="hbFramerate" class="text-input" @bind="framerate">
                        <option value="source">Same as source</option>
                        <option value="23.976">23.976</option>
                        <option value="25">25</option>
                        <option value="29.97">29.97</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="59.94">59.94</option>
                        <option value="60">60</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Framerate mode</label>
                <div class="radio-group">
                    <label class="radio-label">
                        <input type="radio" name="framerateMode" value="cfr" checked="@cfr" @onchange="() => cfr = true" />
                        <span>Constant</span>
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="framerateMode" value="vfr" checked="@(!cfr)" @onchange="() => cfr = false" />
                        <span>Variable</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Automation</h2>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="autoEject" />
                    <span>Eject disc after rip completes</span>
                </label>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="autoStartRip" />
                    <span>Auto-start rip when disc is inserted</span>
                </label>
            </div>

            <div class="form-group">
                <label for="maxParallelRips">Max Parallel Rips</label>
                <input id="maxParallelRips" type="number" min="0" step="1" class="text-input" @bind="maxParallelRips" />
                <p class="hint">Maximum number of concurrent rips. 0 = no limit (naturally capped by the number of drives).</p>
            </div>
        </div>

        <div class="card">
            <h2>Output</h2>
            <p class="card-desc">Where rips and transcodes happen, and where the finished <code>.mp4</code> ends up.</p>

            <div class="form-group">
                <label for="outputDir">Working Directory</label>
                <input id="outputDir" type="text" class="text-input" @bind="outputDir" />
                <p class="hint">Local workspace for ripping and transcoding. Files left here are removed once delivered elsewhere (see below).</p>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="autoDeleteMkv" />
                    <span>Delete .mkv after successful transcode</span>
                </label>
            </div>

            <hr class="card-divider" />
            <h3 class="card-subheading">After Ripping</h3>

            <div class="form-group">
                <label for="postTransferMode">Action</label>
                <div class="select-wrapper">
                    <select id="postTransferMode" class="text-input" @bind="postTransferMode">
                        <option value="None">Keep in working directory</option>
                        <option value="Sftp">Upload to server via SFTP</option>
                        <option value="LocalCopy">Save to a local folder</option>
                        <option value="Both">SFTP upload + local folder</option>
                    </select>
                </div>
                <p class="hint">
                    @if (postTransferMode == "None")
                    {
                        <text>The finished .mp4 stays in the working directory.</text>
                    }
                    else
                    {
                        <text>After delivery, the .mp4 and any leftover .mkv are removed from the working directory.</text>
                    }
                </p>
            </div>

            @if (postTransferMode is "Sftp" or "Both")
            {
                <hr class="card-divider" />
                <h3 class="card-subheading">SFTP Server</h3>

                <div class="form-group">
                    <label for="sftpHost">Host</label>
                    <input id="sftpHost" type="text" class="text-input" @bind="sftpHost" placeholder="192.168.1.10" />
                </div>

                <div class="form-group">
                    <label for="sftpPort">Port</label>
                    <input id="sftpPort" type="number" min="1" max="65535" step="1" class="text-input" @bind="sftpPort" />
                </div>

                <div class="form-group">
                    <label for="sftpUser">Username</label>
                    <input id="sftpUser" type="text" class="text-input" @bind="sftpUser" placeholder="media" />
                </div>

                <div class="form-group">
                    <label for="sftpPassword">Password</label>
                    <input id="sftpPassword" type="password" class="text-input" @bind="sftpPassword" placeholder="••••••••" />
                </div>

                <div class="form-group">
                    <label for="sftpRemotePath">Remote path</label>
                    <div class="input-row">
                        <input id="sftpRemotePath" type="text" class="text-input" @bind="sftpRemotePath" placeholder="/media/movies/" />
                        <button class="btn btn-icon" title="Browse remote folders" @onclick="OpenSftpBrowser"
                                disabled="@(string.IsNullOrWhiteSpace(sftpHost) || string.IsNullOrWhiteSpace(sftpUser))">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M1.5 4.5C1.5 3.67 2.17 3 3 3h3l1.5 1.5H13c.83 0 1.5.67 1.5 1.5v6c0 .83-.67 1.5-1.5 1.5H3c-.83 0-1.5-.67-1.5-1.5v-7.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                    <p class="hint">Folder on the server where the .mp4 will be uploaded. Created if it doesn't exist.</p>
                </div>

                <div class="form-group">
                    <label for="sftpKeyFile">SSH key file (optional)</label>
                    <input id="sftpKeyFile" type="text" class="text-input" @bind="sftpKeyFile" placeholder="~/.ssh/id_ed25519" />
                    <p class="hint">If set and the file exists, key-based authentication is used instead of the password.</p>
                </div>

                <div class="form-group">
                    <button class="btn btn-secondary" @onclick="TestSftpConnection" disabled="@sftpTesting">
                        @if (sftpTesting)
                        {
                            <div class="spinner spinner-sm"></div>
                            <text>Testing…</text>
                        }
                        else
                        {
                            <text>Test Connection</text>
                        }
                    </button>
                    @if (!string.IsNullOrEmpty(sftpTestMessage))
                    {
                        <span style="margin-left: 1rem;" class="badge @(sftpTestSuccess == true ? "badge-green" : "badge-red") saved-badge">@sftpTestMessage</span>
                    }
                </div>
            }

            @if (postTransferMode is "LocalCopy" or "Both")
            {
                <hr class="card-divider" />
                <h3 class="card-subheading">Local Destination</h3>

                <div class="form-group">
                    <label for="localCopyPath">Destination folder</label>
                    <input id="localCopyPath" type="text" class="text-input" @bind="localCopyPath" placeholder="~/Videos/Converted" />
                    <p class="hint">The finished .mp4 is moved here. Folder is created if it doesn't exist.</p>
                </div>
            }
        </div>

        <div class="settings-actions">
            <button class="btn btn-primary" @onclick="SaveSettings">Save</button>
            @if (saved)
            {
                <span class="badge badge-green saved-badge">Saved</span>
            }
        </div>
    </div>

    @if (showSftpBrowser)
    {
        <div class="modal-overlay" @onclick="CloseSftpBrowser">
            <div class="modal-content sftp-modal" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Browse Remote Folders</h2>
                    <button class="modal-close" @onclick="CloseSftpBrowser">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="sftp-browser-bar">
                        <button class="btn btn-icon" title="Up one level" @onclick="SftpBrowserUp"
                                disabled="@(sftpBrowserLoading || sftpBrowserPath == "/")">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M8 3l5 5H10v5H6V8H3l5-5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <span class="mono sftp-browser-path">@sftpBrowserPath</span>
                        <button class="btn btn-secondary sftp-refresh" title="Refresh" @onclick="() => SftpBrowserRefresh()"
                                disabled="@sftpBrowserLoading">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                                <path d="M13 8a5 5 0 1 1-1.46-3.54" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <path d="M13 2v3h-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>

                    <div class="sftp-browser-list">
                        @if (sftpBrowserLoading)
                        {
                            <div class="sftp-browser-state">
                                <div class="spinner"></div>
                                <span>Loading…</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(sftpBrowserError))
                        {
                            <p class="history-error sftp-browser-error">@sftpBrowserError</p>
                            <button class="btn btn-secondary" @onclick="() => SftpBrowserRefresh()">Try again</button>
                        }
                        else if (sftpBrowserDirs.Count == 0)
                        {
                            <p class="sftp-browser-state muted">No subfolders here.</p>
                        }
                        else
                        {
                            @foreach (var dir in sftpBrowserDirs)
                            {
                                var dirName = dir;
                                <button class="sftp-browser-entry" @onclick="() => SftpBrowserInto(dirName)">
                                    <span class="folder-ico">📁</span>
                                    <span class="sftp-browser-name">@dirName</span>
                                </button>
                            }
                        }
                    </div>

                    <div class="sftp-browser-actions">
                        <button class="btn btn-secondary" @onclick="CloseSftpBrowser">Cancel</button>
                        <button class="btn btn-primary" @onclick="SelectSftpFolder">Select this folder</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string apiKey = string.Empty;
    private bool autoDetect = true;
    private string outputDir = "~/Videos/Rips";
    private bool autoDeleteMkv = true;
    private bool autoEject = true;
    private bool autoStartRip = false;
    private int maxParallelRips = 0;
    private bool saved;

    private bool useCustom;
    private List<string> presets = new();
    private string selectedPreset = "Very Fast 1080p30";
    private string selectedEncoder = "x264";
    private double quality = 22.0;
    private string selectedSpeed = "veryfast";
    private bool webOptimized = true;
    private bool alignAv = true;
    private bool chapterMarkers = true;
    private string framerate = "source";
    private bool cfr = false;

    private string postTransferMode = "None";
    private string sftpHost = string.Empty;
    private int sftpPort = 22;
    private string sftpUser = string.Empty;
    private string sftpPassword = string.Empty;
    private string sftpRemotePath = "/media/";
    private string? sftpKeyFile;
    private string localCopyPath = "~/Videos/Converted";

    private bool sftpTesting;
    private bool? sftpTestSuccess;
    private string sftpTestMessage = string.Empty;

    private bool showSftpBrowser;
    private string sftpBrowserPath = "/";
    private List<string> sftpBrowserDirs = new();
    private bool sftpBrowserLoading;
    private string sftpBrowserError = string.Empty;

    private static readonly string[] encoderOptions =
    {
        "x264", "x265", "x264_10bit", "x265_10bit", "x265_12bit",
        "svt_av1", "nvenc_h264", "nvenc_h265"
    };

    protected override async Task OnInitializedAsync()
    {
        var settings = SettingsService.Current;
        if (settings != null)
        {
            apiKey = settings.TmdbApiKey ?? string.Empty;
            autoDetect = settings.UseTmdbAutoDetect;
            outputDir = settings.OutputDirectory;
            autoDeleteMkv = settings.AutoDeleteMkv;
            autoEject = settings.AutoEjectAfterRip;
autoStartRip = settings.AutoStartRip;
        maxParallelRips = settings.MaxParallelRips;
        useCustom = settings.UseCustomHandbrake;
            selectedPreset = settings.HandbrakePreset;
            selectedEncoder = settings.HandbrakeEncoder ?? "x264";
            quality = settings.HandbrakeQuality;
            selectedSpeed = settings.HandbrakeSpeed ?? "veryfast";
            webOptimized = settings.HandbrakeWebOptimized;
            alignAv = settings.HandbrakeAlignAv;
            chapterMarkers = settings.HandbrakeMarkers;
            framerate = settings.HandbrakeFramerate ?? "source";
            cfr = settings.HandbrakeCfr;

            postTransferMode = settings.PostTransferMode.ToString();
            sftpHost = settings.SftpHost ?? string.Empty;
            sftpPort = settings.SftpPort;
            sftpUser = settings.SftpUser ?? string.Empty;
            sftpPassword = settings.SftpPassword ?? string.Empty;
            sftpRemotePath = settings.SftpRemotePath;
            sftpKeyFile = settings.SftpKeyFile;
            localCopyPath = settings.LocalCopyPath;
        }

        presets = await HandbrakeService.GetPresetsAsync();
        if (!presets.Contains(selectedPreset) && presets.Count > 0)
            selectedPreset = presets[0];
    }

    private async Task SaveSettings()
    {
        if (SettingsService.Current == null) return;

        SettingsService.Current.TmdbApiKey = string.IsNullOrWhiteSpace(apiKey) ? null : apiKey.Trim();
        SettingsService.Current.UseTmdbAutoDetect = autoDetect;
        SettingsService.Current.OutputDirectory = outputDir;
        SettingsService.Current.AutoDeleteMkv = autoDeleteMkv;
        SettingsService.Current.AutoEjectAfterRip = autoEject;
        SettingsService.Current.AutoStartRip = autoStartRip;
        SettingsService.Current.MaxParallelRips = maxParallelRips;
        SettingsService.Current.UseCustomHandbrake = useCustom;
        SettingsService.Current.HandbrakePreset = selectedPreset;
        SettingsService.Current.HandbrakeEncoder = selectedEncoder;
        SettingsService.Current.HandbrakeQuality = quality;
        SettingsService.Current.HandbrakeSpeed = selectedSpeed;
        SettingsService.Current.HandbrakeWebOptimized = webOptimized;
        SettingsService.Current.HandbrakeAlignAv = alignAv;
        SettingsService.Current.HandbrakeMarkers = chapterMarkers;
        SettingsService.Current.HandbrakeFramerate = framerate;
        SettingsService.Current.HandbrakeCfr = cfr;

        SettingsService.Current.PostTransferMode = postTransferMode switch
        {
            "Sftp" => TransferMode.Sftp,
            "LocalCopy" => TransferMode.LocalCopy,
            "Both" => TransferMode.Both,
            _ => TransferMode.None
        };
        SettingsService.Current.SftpHost = string.IsNullOrWhiteSpace(sftpHost) ? null : sftpHost.Trim();
        SettingsService.Current.SftpPort = sftpPort > 0 ? sftpPort : 22;
        SettingsService.Current.SftpUser = string.IsNullOrWhiteSpace(sftpUser) ? null : sftpUser.Trim();
        SettingsService.Current.SftpPassword = string.IsNullOrWhiteSpace(sftpPassword) ? null : sftpPassword;
        SettingsService.Current.SftpRemotePath = sftpRemotePath;
        SettingsService.Current.SftpKeyFile = string.IsNullOrWhiteSpace(sftpKeyFile) ? null : sftpKeyFile.Trim();
        SettingsService.Current.LocalCopyPath = string.IsNullOrWhiteSpace(localCopyPath) ? "~/Videos/Converted" : localCopyPath;

        await SettingsService.SaveAsync();

        saved = true;
        await Task.Delay(2000);
        saved = false;
    }

    private async Task TestSftpConnection()
    {
        sftpTesting = true;
        sftpTestSuccess = null;
        sftpTestMessage = string.Empty;
        StateHasChanged();

        try
        {
            var probe = new AutoRip.Models.Settings
            {
                SftpHost = sftpHost.Trim(),
                SftpPort = sftpPort > 0 ? sftpPort : 22,
                SftpUser = sftpUser.Trim(),
                SftpPassword = sftpPassword,
                SftpKeyFile = string.IsNullOrWhiteSpace(sftpKeyFile) ? null : sftpKeyFile.Trim(),
                SftpRemotePath = sftpRemotePath
            };

            var remote = await TransferService.TestSftpConnectionAsync(probe);
            sftpTestSuccess = true;
            sftpTestMessage = $"Connected ({remote})";
        }
        catch (Exception ex)
        {
            sftpTestSuccess = false;
            sftpTestMessage = ex.Message;
        }
        finally
        {
            sftpTesting = false;
            StateHasChanged();
        }
    }

    private async Task OpenSftpBrowser()
    {
        showSftpBrowser = true;
        var start = string.IsNullOrWhiteSpace(sftpRemotePath) ? "/" : sftpRemotePath.TrimEnd('/');
        if (string.IsNullOrEmpty(start)) start = "/";
        sftpBrowserPath = start;
        sftpBrowserError = string.Empty;
        sftpBrowserDirs = new();
        StateHasChanged();
        await SftpBrowserLoad();
    }

    private void CloseSftpBrowser()
    {
        showSftpBrowser = false;
        sftpBrowserError = string.Empty;
        sftpBrowserDirs = new();
    }

    private async Task SftpBrowserRefresh() => await SftpBrowserLoad();

    private async Task SftpBrowserInto(string dir)
    {
        sftpBrowserPath = CombineRemote(sftpBrowserPath, dir);
        await SftpBrowserLoad();
    }

    private async Task SftpBrowserUp()
    {
        sftpBrowserPath = ParentRemote(sftpBrowserPath);
        await SftpBrowserLoad();
    }

    private async Task SftpBrowserLoad()
    {
        sftpBrowserLoading = true;
        sftpBrowserError = string.Empty;
        sftpBrowserDirs = new();
        StateHasChanged();

        try
        {
            var probe = BuildSftpProbe();
            sftpBrowserDirs = (await TransferService.ListSftpDirectoriesAsync(sftpBrowserPath, probe)).ToList();
        }
        catch (Exception ex)
        {
            sftpBrowserError = ex.Message;
        }
        finally
        {
            sftpBrowserLoading = false;
            StateHasChanged();
        }
    }

    private void SelectSftpFolder()
    {
        var path = sftpBrowserPath;
        if (path != "/" && !path.EndsWith('/')) path += "/";
        sftpRemotePath = path;
        CloseSftpBrowser();
    }

    private AutoRip.Models.Settings BuildSftpProbe() => new()
    {
        SftpHost = sftpHost.Trim(),
        SftpPort = sftpPort > 0 ? sftpPort : 22,
        SftpUser = sftpUser.Trim(),
        SftpPassword = sftpPassword,
        SftpKeyFile = string.IsNullOrWhiteSpace(sftpKeyFile) ? null : sftpKeyFile.Trim(),
        SftpRemotePath = sftpBrowserPath
    };

    private static string CombineRemote(string parent, string child)
    {
        if (string.IsNullOrEmpty(parent) || parent == "/") return "/" + child;
        return parent.TrimEnd('/') + "/" + child;
    }

    private static string ParentRemote(string path)
    {
        if (string.IsNullOrEmpty(path) || path == "/") return "/";
        var trimmed = path.TrimEnd('/');
        var idx = trimmed.LastIndexOf('/');
        if (idx <= 0) return "/";
        return trimmed[..idx];
    }
}
