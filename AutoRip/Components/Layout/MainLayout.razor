@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing

<div class="app-layout">
    <nav class="sidebar">
        <div class="sidebar-brand">
            <span class="sidebar-logo">AUTO<span>RIP</span></span>
        </div>

        <div class="sidebar-nav">
            <NavLink href="/" Match="NavLinkMatch.All" ActiveClass="active">
                <div class="sidebar-item">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <rect x="2.5" y="2.5" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
                        <rect x="11.5" y="2.5" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
                        <rect x="2.5" y="11.5" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
                        <rect x="11.5" y="11.5" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
                    </svg>
                    <span>Dashboard</span>
                </div>
            </NavLink>

            <NavLink href="/logs" Match="NavLinkMatch.Prefix" ActiveClass="active">
                <div class="sidebar-item">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M4 3h9a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2z" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M15 7h2a1 1 0 011 1v8a2 2 0 01-2 2H7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    <span>Logs</span>
                </div>
            </NavLink>

            <NavLink href="/collection" Match="NavLinkMatch.Prefix" ActiveClass="active">
                <div class="sidebar-item">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <rect x="1" y="1" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.8"/>
                        <circle cx="7" cy="7" r="2.5" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M3 17l5-5 3 3 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>Collection</span>
                </div>
            </NavLink>

            <NavLink href="/settings" Match="NavLinkMatch.Prefix" ActiveClass="active">
                <div class="sidebar-item">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <circle cx="10" cy="10" r="3.5" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M10 1v3M10 16v3M3.5 3.5l2.1 2.1M14.4 14.4l2.1 2.1M1 10h3m12 0h3M3.5 16.5l2.1-2.1m8.8-8.8l2.1-2.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    <span>Settings</span>
                </div>
            </NavLink>
        </div>

        <div class="sidebar-footer">
            <div class="sidebar-status">
                <span class="status-dot @(driveCount > 0 ? "status-ok" : "status-off")"></span>
                <span>@(driveCount > 0 ? $"{driveCount} drive{(driveCount > 1 ? "s" : "")}" : "No drives")</span>
            </div>
        </div>
    </nav>

    <main class="main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] public Services.DriveService DriveService { get; set; } = default!;
    private int driveCount;

    protected override void OnInitialized()
    {
        UpdateDriveCount();
        DriveService.DrivesChanged += _ => { UpdateDriveCount(); InvokeAsync(StateHasChanged); };
    }

    private void UpdateDriveCount() => driveCount = DriveService.Drives.Count;
}
